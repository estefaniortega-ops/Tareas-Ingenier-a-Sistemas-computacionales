#importaciones no necesarias

#Saber el área de un rectángulo cuando el usuario establece los datos
def calcular_area(A,B):
#calcular el área multiplicando las variables
    return (A * B)

#bloque principal 
__name__== "__main__"
print (calcular_area)

#Entrada de datos
A = float(input("Ingresa la base del rectángulo: "))
B = float(input("Ingresa la altura del rectángulo: "))

#Proceso
resultado = calcular_area (A,B)

#Salida
print (f"El área del rectángulo es: {resultado}")
